# URL base da API do GT Leagues
GT_API_BASE_URL=https://www.gtleagues.com/api

# ID da temporada a monitorar (pode ser múltiplos separados por vírgula)
GT_SEASON_IDS=19211

# Intervalo de varredura em minutos (padrão: 5)
SCRAPER_INTERVAL_MINUTES=5

# Porta do servidor Flask
FLASK_PORT=5000
FLASK_DEBUG=false

# Chave secreta Flask
SECRET_KEY=gtscout-secret-change-me
